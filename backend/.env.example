PORT=5000
FRONTEND_URL=http://localhost:5173
FIREBASE_STORAGE_BUCKET=achar-bari.firebasestorage.app

# Firebase Admin: use firebase-service-account.json instead of putting the private key in .env.
# Keep the real JSON file in backend/ and never commit it.

RAZORPAY_ENABLED=false
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

EMAILJS_SERVICE_ID=
EMAILJS_TEMPLATE_ID=
EMAILJS_PUBLIC_KEY=

# Separate EmailJS credentials/templates for each customer email type.
EMAILJS_ACCEPTED_SERVICE_ID=
EMAILJS_ACCEPTED_TEMPLATE_ID=
EMAILJS_ACCEPTED_PUBLIC_KEY=
EMAILJS_ACCEPTED_PRIVATE_KEY=

EMAILJS_REJECTED_SERVICE_ID=
EMAILJS_REJECTED_TEMPLATE_ID=
EMAILJS_REJECTED_PUBLIC_KEY=
EMAILJS_REJECTED_PRIVATE_KEY=

EMAILJS_PACKED_SERVICE_ID=
EMAILJS_PACKED_TEMPLATE_ID=
EMAILJS_PACKED_PUBLIC_KEY=
EMAILJS_PACKED_PRIVATE_KEY=

EMAILJS_SHIPPED_SERVICE_ID=
EMAILJS_SHIPPED_TEMPLATE_ID=
EMAILJS_SHIPPED_PUBLIC_KEY=
EMAILJS_SHIPPED_PRIVATE_KEY=

EMAILJS_WELCOME_SERVICE_ID=
EMAILJS_WELCOME_TEMPLATE_ID=
EMAILJS_WELCOME_PUBLIC_KEY=
EMAILJS_WELCOME_PRIVATE_KEY=

EMAILJS_STOCK_SERVICE_ID=
EMAILJS_STOCK_TEMPLATE_ID=
EMAILJS_STOCK_PUBLIC_KEY=
EMAILJS_STOCK_PRIVATE_KEY=

# Customized pickle request EmailJS (separate account/service/template if desired)
CUSTOM_EMAILJS_SERVICE_ID=
CUSTOM_EMAILJS_TEMPLATE_ID=
CUSTOM_EMAILJS_PUBLIC_KEY=
CUSTOM_EMAILJS_PRIVATE_KEY=
CUSTOM_EMAILJS_TO=
